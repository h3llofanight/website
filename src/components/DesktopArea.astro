---
import DesktopIcon from './DesktopIcon.astro';

interface Entry {
  id: string;
  title: string;
  type: string;
  folder?: string;
  icon?: string;
}

interface Props {
  entries: Entry[];
  base: string;
  iconMap: Record<string, string>;
}

const { entries, base, iconMap } = Astro.props;

const rootEntries = entries.filter(e => !e.folder);
---

<div id="desktop-area">
  {rootEntries.map((entry, i) => (
    <DesktopIcon
      entryId={entry.id}
      title={entry.title}
      type={entry.type}
      iconSrc={entry.icon || iconMap[entry.type] || iconMap.text}
      index={i}
    />
  ))}
</div>
