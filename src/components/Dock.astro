---
interface DockItem {
  id: string;
  title: string;
  icon?: string;
  url?: string;
  entryId?: string;
}

interface Props {
  base: string;
  items: DockItem[];
  defaultIcon: string;
}

const { base, items, defaultIcon } = Astro.props;
---

<div id="dock">
  {items.length > 0 ? (
    items.map((item) => (
      <div
        class="dock-icon"
        title={item.title}
        data-dock-id={item.id}
        data-url={item.url || ''}
        data-entry-id={item.entryId || ''}
      >
        <img
          src={item.icon || defaultIcon}
          alt={item.title}
          width="46"
          height="46"
          draggable="false"
        />
      </div>
    ))
  ) : (
    <div class="dock-icon" data-action="show-desktop" title="Finder">
      <img src={defaultIcon} alt="Finder" width="46" height="46" draggable="false" />
    </div>
  )}
</div>
