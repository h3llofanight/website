---
import DesktopArea from '../components/DesktopArea.astro';
import Dock from '../components/Dock.astro';
import '../styles/global.css';
import '../styles/desktop.css';
import '../styles/window.css';
import '../styles/finder.css';
import '../styles/dock.css';
import '../styles/content.css';

interface ContentEntry {
  id: string;
  title: string;
  type: string;
  folder?: string;
  icon?: string;
  videoUrl?: string;
  videoFile?: string;
  imageUrl?: string;
}

interface DockItem {
  id: string;
  title: string;
  icon?: string;
  url?: string;
  entryId?: string;
}

interface Props {
  entries: ContentEntry[];
  base: string;
  siteTitle: string;
  siteDescription: string;
  wallpaper?: string;
  iconOverrides: {
    text?: string;
    image?: string;
    video?: string;
    folder?: string;
  };
  dockItems: DockItem[];
}

const { entries, base, siteTitle, siteDescription, wallpaper, iconOverrides, dockItems } = Astro.props;

const iconMap: Record<string, string> = {
  text: iconOverrides.text || `${base}/icons/file-text.svg`,
  image: iconOverrides.image || `${base}/icons/file-image.svg`,
  video: iconOverrides.video || `${base}/icons/file-video.svg`,
  folder: iconOverrides.folder || `${base}/icons/folder.svg`,
};

const wallpaperUrl = wallpaper || '';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteDescription} />
    <title>{siteTitle}</title>
  </head>
  <body>
    <div id="desktop">
      {wallpaperUrl ? (
        <div id="desktop-wallpaper" style={`background-image: url('${wallpaperUrl}');`}></div>
      ) : (
        <div id="desktop-wallpaper"></div>
      )}
      <DesktopArea entries={entries} base={base} iconMap={iconMap} />
      <div id="window-layer"></div>
      <Dock base={base} items={dockItems} defaultIcon={iconMap.folder} />
    </div>

    <script type="application/json" id="desktop-data" set:html={JSON.stringify({
      entries,
      iconMap,
      base,
      dockItems,
    })} />

    <template id="window-template">
      <div class="window">
        <div class="window-titlebar">
          <div class="traffic-lights">
            <button class="traffic-light tl-close" aria-label="Close">
              <svg viewBox="0 0 12 12"><path d="M3.5 3.5l5 5M8.5 3.5l-5 5" stroke="#4d0000" stroke-width="1.2" stroke-linecap="round"/></svg>
            </button>
            <button class="traffic-light tl-minimize" aria-label="Minimize">
              <svg viewBox="0 0 12 12"><path d="M2.5 6h7" stroke="#995700" stroke-width="1.2" stroke-linecap="round"/></svg>
            </button>
            <button class="traffic-light tl-maximize" aria-label="Maximize">
              <svg viewBox="0 0 12 12"><path d="M3 3h6v6H3z" stroke="#006500" stroke-width="1.1" fill="none" stroke-linejoin="round"/></svg>
            </button>
          </div>
          <span class="window-title"></span>
        </div>
        <div class="window-content"></div>
      </div>
    </template>

    <slot />

    <script>
      import { initDesktop } from '../scripts/desktop';
      initDesktop();
    </script>
  </body>
</html>
