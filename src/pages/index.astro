---
import { getCollection, render } from 'astro:content';
import Desktop from '../layouts/Desktop.astro';

const pages = await getCollection('pages');
const siteEntries = await getCollection('site');
const dockEntries = await getCollection('dock');

const siteSettings = siteEntries[0]?.data ?? { title: 'Desktop', description: 'A personal website' };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const dockItems = dockEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((d) => ({
    id: d.id,
    title: d.data.title,
    icon: d.data.icon || undefined,
    url: d.data.url || undefined,
    entryId: d.data.entry_id || undefined,
  }));

// Derive folder structure from filesystem paths.
// - _index files define folders (id like "projects/_index" → folder path "projects")
// - Other files belong to their parent directory (id like "projects/sample-project" → folder "projects")
// - Root-level files (id like "about") have no folder
const entries = pages.map((page) => {
  const id = page.id; // e.g. "about", "projects/_index", "projects/sample-project", "projects/2024/_index"
  const isIndex = id.endsWith('/_index');

  if (isIndex) {
    // This is a folder definition
    const folderPath = id.replace(/\/_index$/, ''); // "projects" or "projects/2024"
    const parentFolder = folderPath.includes('/')
      ? folderPath.substring(0, folderPath.lastIndexOf('/'))
      : undefined;
    return {
      id: folderPath,
      title: page.data.title,
      type: 'folder' as const,
      folder: parentFolder,
      icon: page.data.icon || undefined,
      videoUrl: undefined,
      videoFile: undefined,
      imageUrl: undefined,
    };
  }

  // Regular file
  const parentFolder = id.includes('/')
    ? id.substring(0, id.lastIndexOf('/'))
    : undefined;
  return {
    id,
    title: page.data.title,
    type: page.data.type || 'text',
    folder: parentFolder,
    icon: page.data.icon || undefined,
    videoUrl: page.data.video_url || undefined,
    videoFile: page.data.video || undefined,
    imageUrl: page.data.image || undefined,
  };
});

const renderedPages = await Promise.all(
  pages
    .filter((page) => !page.id.endsWith('/_index'))
    .map(async (page) => ({
      id: page.id,
      rendered: await render(page),
    }))
);
---

<Desktop
  entries={entries}
  base={base}
  siteTitle={siteSettings.title}
  siteDescription={siteSettings.description}
  wallpaper={siteSettings.wallpaper}
  iconOverrides={{
    text: siteSettings.icon_text,
    image: siteSettings.icon_image,
    video: siteSettings.icon_video,
    folder: siteSettings.icon_folder,
  }}
  dockItems={dockItems}
>
  {renderedPages.map(({ id, rendered }) => {
    const { Content } = rendered;
    return (
      <template data-content-id={id}>
        <Content />
      </template>
    );
  })}
</Desktop>
